{
  "name": "casebound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lit 3D hardcover books for the browser with three.js: a damped shelf, books that open, pages that turn like paper, a magnifier and page light effects. Every book is a few lines of data, and a coding-agent skill is included.",
  "homepage": "https://othmanadi.github.io/casebound/",
  "repository": { "type": "git", "url": "git+https://github.com/OthmanAdi/casebound.git" },
  "author": "OthmanAdi (https://github.com/OthmanAdi)",
  "keywords": ["threejs", "webgl", "3d-book", "page-turn", "page-flip", "bookshelf", "ebook-reader", "magnifier", "shader", "typescript", "agent-skills"],
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
